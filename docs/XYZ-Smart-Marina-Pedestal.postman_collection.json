            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:8082/api/pedestals"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('pedestalId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "response": []
