          "raw": "{\n  \"serialNumber\": \"XYZ-PED-001\",\n  \"name\": \"Borne Ponton A1\",\n  \"portId\": {{portId}},\n  \"pontoon\": \"A\",\n  \"status\": \"ACTIVE\"\n}",
